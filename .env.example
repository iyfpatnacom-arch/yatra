# ─────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. .env.local is gitignored.
# ─────────────────────────────────────────────────────────────

# --- Database (required) -------------------------------------
# MongoDB Atlas connection string. ID-proof photos are stored in
# GridFS inside this same database, so no other storage service
# is needed.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=iskcon_yatra

# --- Admin dashboard (required) ------------------------------
# The single shared password for /hi/admin.
ADMIN_PASSWORD=change-me

# Random string used to sign the admin session cookie.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# --- Fees (INR) ----------------------------------------------
# Full yatra fee per traveller. Changing these changes the price
# for NEW registrations only; existing rows keep the fee they
# were created with.
# NEXT_PUBLIC_ is required: the fee summary is a client component
# and would otherwise show a different number from the one the
# server charges.
NEXT_PUBLIC_FEE_YOUTH=5100
NEXT_PUBLIC_FEE_FAMILY_SLEEPER=8000
NEXT_PUBLIC_FEE_FAMILY_AC=10000

# Collected online today, per traveller. The balance is settled
# with the coordinator before departure. Set this small (e.g. 2)
# to exercise a live gateway cheaply.
NEXT_PUBLIC_ADVANCE_PER_PERSON=2000

# --- Public trip details (shown on the landing page) ---------
NEXT_PUBLIC_TRIP_START=2026-11-06
NEXT_PUBLIC_TRIP_END=2026-11-09
# Departure time (IST, 24-hour) the homepage countdown runs to.
NEXT_PUBLIC_TRIP_DEPART_TIME=06:00

# Hosts the hero carousel may load photos from, comma separated.
# Leave empty when the photos live in /public.
NEXT_PUBLIC_IMAGE_HOSTS=

# The WhatsApp group each category joins once its payment
# succeeds — offered as a button on the status page and appended
# to the confirmation message. The two wings run separate groups.
# NEXT_PUBLIC_ is required: the link is printed on the page.
# Defaults to the live groups in lib/config.js when unset.
# NEXT_PUBLIC_WHATSAPP_GROUP_YOUTH=https://chat.whatsapp.com/xxxxxxxx
# NEXT_PUBLIC_WHATSAPP_GROUP_FAMILY=https://chat.whatsapp.com/xxxxxxxx
NEXT_PUBLIC_CONTACT_PHONE=+91 00000 00000
NEXT_PUBLIC_CONTACT_EMAIL=official.iyfpatna@gmail.com


# --- ID proof upload -----------------------------------------
# Max size of an uploaded ID photo, in KILOBYTES. The browser
# resizes the photo down to this budget before it will let the
# form submit, and the server rejects anything over it. Raise it
# if coordinators complain that IDs are unreadable; 200 KB is
# comfortably legible for an Aadhaar or PAN card.
# NEXT_PUBLIC_ is required: the browser must enforce the same
# number the server does.
NEXT_PUBLIC_MAX_ID_PROOF_KB=200

# --- Coordinator helplines -----------------------------------
# Shown under the countdown, in the footer, and on /contact.
# Comma separated, 10 digits, no +91 — the site adds that itself.
# Youth and family bookings are handled by different coordinators.
NEXT_PUBLIC_HELPLINE_YOUTH=9031683002,9031054013
NEXT_PUBLIC_HELPLINE_FAMILY=9031478248,9031054012

# --- Legal pages ---------------------------------------------
# The entity named on /privacy, /terms, /refund and /shipping.
# This MUST match the merchant registered with CCAvenue, or the
# application is rejected on the website review.
NEXT_PUBLIC_ORG_LEGAL_NAME=ISKCON Patna

# Bare domain printed in the Terms and Privacy pages. Set it even
# on localhost, so what you proofread is what goes live.
NEXT_PUBLIC_ORG_DOMAIN=iyfpatna.cloud

# Registered address, printed on the legal and contact pages.
NEXT_PUBLIC_ORG_ADDRESS=Sri Sri Radha Banke Bihari Temple, Buddha Marg, Patna - 800001, Bihar, India

# "Last updated" date shown at the top of every policy page.
# Bump it whenever you edit lib/i18n/legal-en.js or legal-hi.js.
NEXT_PUBLIC_POLICY_UPDATED=2026-08-29
# --- Public site URL (required for payments) -----------------
# Absolute HTTPS origin, no trailing slash. CCAvenue posts the
# payment result back to {NEXT_PUBLIC_SITE_URL}/api/payment/response,
# so this URL must be reachable from the internet and registered
# with CCAvenue. Payments therefore cannot be tested on localhost.
NEXT_PUBLIC_SITE_URL=https://iyfpatna.cloud

# --- CCAvenue (non-seamless redirect) ------------------------
# MARS dashboard → Settings → API Keys. Leave any of the three
# blank and the site still takes registrations, it just skips
# the payment step and shows the "payment opens later" copy.
CCAVENUE_MERCHANT_ID=
CCAVENUE_ACCESS_CODE=
CCAVENUE_WORKING_KEY=

# test (default) or production. Anything other than the literal
# string "production" uses https://test.ccavenue.com, so a
# forgotten value cannot move real money.
CCAVENUE_ENV=test

# Which encryption your account is provisioned for:
#   aes128 (default) — MD5-derived key, AES-128-CBC. Classic kit.
#   aes256           — 32-byte working key, AES-256-GCM.
# Getting this wrong shows up as CCAvenue error 10002. The
# transaction URL follows from it automatically.
CCAVENUE_ENCRYPTION=aes128

# Only if CCAvenue gives you a non-standard transaction URL.
# CCAVENUE_ENDPOINT=

# Server-to-server API (order status lookups from the admin
# dashboard). Requires this server's public IP to be registered
# with CCAvenue. Defaults to apitest/api.ccavenue.com to match
# CCAVENUE_ENV.
# CCAVENUE_API_URL=

# --- BotBiz (WhatsApp) ---------------------------------------
# PAUSED. CCAvenue emails the traveller a receipt the moment a
# payment succeeds, so the WhatsApp confirmation is switched off
# and nothing is sent to BotBiz — the status page points people
# at their email instead. Set this to the literal string "true"
# to resume; any other value (including unset) keeps it paused.
WHATSAPP_ENABLED=false

# Payment confirmations to the traveller and an alert to the
# coordinator, once WHATSAPP_ENABLED is on. Leave BOTBIZ_API_KEY
# blank to disable messaging entirely; payments keep working
# without it.
BOTBIZ_API_KEY=
BOTBIZ_PHONE_NUMBER_ID=
# BOTBIZ_API_URL=https://dash.botbiz.io/api/v1

# Approved template name, for reaching travellers outside the
# 24-hour WhatsApp session window. Optional: with no template
# set, confirmations go as plain session text, which only lands
# if the traveller has messaged the business number recently.
# The template's body placeholders receive, in order:
#   {{1}} name  {{2}} registration id  {{3}} travellers  {{4}} amount
# BOTBIZ_TEMPLATE_CONFIRMATION=registration
# BOTBIZ_TEMPLATE_LANGUAGE=en
# BotBiz's published docs do not include the template-send
# endpoint; override the path here if yours differs.
# BOTBIZ_TEMPLATE_PATH=/whatsapp/send/template

# Overrides both group links below with a single group for
# everyone. Leave unset unless the yatra runs only one group.
# WHATSAPP_GROUP_INVITE_URL=https://chat.whatsapp.com/xxxxxxxx

# Gets a message for every paid registration, and a warning if a
# payment ever comes back for the wrong amount.
# COORDINATOR_WHATSAPP=919999999999
